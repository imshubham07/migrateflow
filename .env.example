# Copy this file to .env for local development, then replace placeholders.
# Never commit .env or real credentials.

# PostgreSQL connection used by Prisma.
# For a managed database, replace this with the provider's connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/migrateflow?schema=public"

# Gemini API credentials and model.
GEMINI_API_KEY="replace-with-your-gemini-api-key"
GEMINI_MODEL="gemini-3.5-flash"

# Backend server and frontend-to-backend access.
PORT="4000"
CORS_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Upload/sample and logging limits.
MAX_SAMPLE_RECORDS="1000"
LOG_LEVEL="info"
